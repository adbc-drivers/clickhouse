// part: metadata

[tags]
caveats = ["DateTime64 has limited range (1900 to 2299)"]
sql-type-name = "DateTime64(2)"

// part: setup_query

CREATE TABLE test_timestamp (
    idx Int32,
    res Nullable(DateTime64(2))
) ENGINE = MergeTree() ORDER BY idx;

INSERT INTO test_timestamp (idx, res) VALUES (1, '2023-05-15 13:45:30.12');
INSERT INTO test_timestamp (idx, res) VALUES (2, '2000-01-01 00:00:00.23');
INSERT INTO test_timestamp (idx, res) VALUES (3, '1969-07-20 20:17:40.34');
INSERT INTO test_timestamp (idx, res) VALUES (4, '1900-01-01 00:00:00.00');
INSERT INTO test_timestamp (idx, res) VALUES (5, '2299-12-31 23:59:59.99');
INSERT INTO test_timestamp (idx, res) VALUES (6, NULL);

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "tsm:UTC",
            "flags": ["nullable"]
        }
    ]
}

// part: expected

{"res": 1684158330120}
{"res": 946684800230}
{"res": -14182939660}
{"res": -2208988800000}
{"res": 10413791999990}
{"res": null}

// part: metadata

[tags]
caveats = ["DateTime64 has limited range (1900 to 2299)"]
sql-type-name = "DateTime64(4, UTC)"

// part: setup_query

CREATE TABLE test_timestamptz (
    idx Int32,
    res Nullable(DateTime64(4, 'UTC'))
) ENGINE = MergeTree() ORDER BY idx;

INSERT INTO test_timestamptz (idx, res) VALUES (1, '2023-05-15 13:45:30.1234');
INSERT INTO test_timestamptz (idx, res) VALUES (2, '2000-01-01 00:00:00.2345');
INSERT INTO test_timestamptz (idx, res) VALUES (3, '1969-07-20 20:17:40.3456');
INSERT INTO test_timestamptz (idx, res) VALUES (4, '1900-01-01 00:00:00.0000');
INSERT INTO test_timestamptz (idx, res) VALUES (5, '2299-12-31 23:59:59.9999');
INSERT INTO test_timestamptz (idx, res) VALUES (6, NULL);

// part: expected

{"res": 1684158330123400}
{"res": 946684800234500}
{"res": -14182939654400}
{"res": -2208988800000000}
{"res": 10413791999999900}
{"res": null}

